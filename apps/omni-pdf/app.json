{
  "id": "omni-pdf",
  "name": "PDF 도구",
  "description": "PDF를 합치고 나누거나 다른 형식으로 바꿉니다",
  "icon": {
    "asset": "omni-pdf-icon",
    "version": 1
  },
  "requires": {
    "blocks": 37,
    "modules": {
      "assets": 1,
      "client": 4
    }
  },
  "permissions": [],
  "assets": [
    {
      "id": "omni-pdf-client",
      "version": 1
    },
    {
      "id": "omni-pdf-icon",
      "version": 1
    },
    {
      "id": "omni-pdf-worker",
      "version": 1
    },
    {
      "id": "omni-pdf-resources",
      "version": 1
    }
  ],
  "state": {
    "tool": "PDF 합치기",
    "o_split_pdf_pageRanges": "",
    "o_rotate_pdf_rotationAngle": 90,
    "o_rotate_pdf_applyToAllPages": true,
    "o_rotate_pdf_pageRanges": "",
    "o_convert_to_pdf_pageType": "full",
    "o_convert_to_pdf_orientation": "portrait",
    "o_convert_to_pdf_scale": 100
  },
  "client": {
    "runtime": "javascript",
    "entry": {
      "id": "omni-pdf-client",
      "version": 1
    },
    "inputs": {
      "tool": {
        "expr": "($t := [{\"id\":\"merge-pdf\",\"name\":\"PDF 합치기\",\"input\":\"pdfs\",\"result\":\"file\"},{\"id\":\"split-pdf\",\"name\":\"PDF 나누기\",\"input\":\"pdf\",\"result\":\"file\"},{\"id\":\"rotate-pdf\",\"name\":\"PDF 회전\",\"input\":\"pdf\",\"result\":\"file\"},{\"id\":\"convert-to-pdf\",\"name\":\"그림을 PDF로\",\"input\":\"images\",\"result\":\"file\"},{\"id\":\"pdf-to-png\",\"name\":\"PDF를 PNG로\",\"input\":\"pdf\",\"result\":\"files\"},{\"id\":\"extract-images-from-pdf\",\"name\":\"PDF에서 그림 추출\",\"input\":\"pdf\",\"result\":\"files\"},{\"id\":\"pdf-to-epub\",\"name\":\"PDF를 EPUB으로\",\"input\":\"pdf\",\"result\":\"file\"}]; $s := $t[name = $state.tool][0]; $exists($s) ? $s : $t[0]).id"
      },
      "options": {
        "expr": "$state.tool = \"PDF 합치기\" ? {} : ($state.tool = \"PDF 나누기\" ? {\"pageRanges\":$state.o_split_pdf_pageRanges} : ($state.tool = \"PDF 회전\" ? {\"rotationAngle\":$state.o_rotate_pdf_rotationAngle,\"applyToAllPages\":$state.o_rotate_pdf_applyToAllPages,\"pageRanges\":$state.o_rotate_pdf_pageRanges} : ($state.tool = \"그림을 PDF로\" ? {\"pageType\":$state.o_convert_to_pdf_pageType,\"orientation\":$state.o_convert_to_pdf_orientation,\"scale\":$state.o_convert_to_pdf_scale} : ($state.tool = \"PDF를 PNG로\" ? {} : ($state.tool = \"PDF에서 그림 추출\" ? {} : ($state.tool = \"PDF를 EPUB으로\" ? {} : ({})))))))"
      }
    },
    "outputs": {
      "filename": {
        "default": ""
      },
      "error": {
        "default": null
      },
      "has_error": {
        "default": false
      },
      "has_input": {
        "default": false
      },
      "no_input": {
        "default": true
      },
      "has_result": {
        "default": false
      },
      "no_result": {
        "default": true
      },
      "loading": {
        "default": false
      },
      "pdf_surface": {
        "default": false
      },
      "input_rows": {
        "default": []
      },
      "result_rows": {
        "default": []
      },
      "page_info": {
        "default": ""
      },
      "image_info": {
        "default": ""
      },
      "format_pdf": {
        "default": false
      },
      "format_epub": {
        "default": false
      },
      "format_zip": {
        "default": false
      },
      "format_png": {
        "default": false
      },
      "lock_2_2": {
        "default": true
      },
      "lock_3_1": {
        "default": true
      },
      "lock_3_2": {
        "default": true
      }
    },
    "actions": [
      "load",
      "save",
      "remove",
      "move_up",
      "move_down"
    ]
  },
  "ui": {
    "type": "stack",
    "direction": "column",
    "fill": 1,
    "children": [
      {
        "type": "toolbar",
        "start": [
          {
            "type": "input",
            "label": "도구",
            "value": {
              "state": "tool"
            },
            "on_change": {
              "set_state": "tool"
            },
            "options_only": true,
            "options": [
              {
                "value": "PDF 합치기",
                "label": "PDF 합치기",
                "description": "여러 PDF를 선택한 순서로 합칩니다"
              },
              {
                "value": "PDF 나누기",
                "label": "PDF 나누기",
                "description": "선택한 쪽을 새 PDF로 만듭니다"
              },
              {
                "value": "PDF 회전",
                "label": "PDF 회전",
                "description": "선택한 쪽을 회전합니다"
              },
              {
                "value": "그림을 PDF로",
                "label": "그림을 PDF로",
                "description": "그림을 한 PDF로 만듭니다"
              },
              {
                "value": "PDF를 PNG로",
                "label": "PDF를 PNG로",
                "description": "각 쪽을 PNG 그림으로 만듭니다"
              },
              {
                "value": "PDF에서 그림 추출",
                "label": "PDF에서 그림 추출",
                "description": "PDF에 든 그림을 꺼냅니다"
              },
              {
                "value": "PDF를 EPUB으로",
                "label": "PDF를 EPUB으로",
                "description": "PDF의 글을 EPUB으로 만듭니다"
              }
            ]
          }
        ]
      },
      {
        "type": "split",
        "direction": "row",
        "column_below": 640,
        "sizes": [
          1,
          1
        ],
        "children": [
          {
            "type": "section",
            "title": "입력",
            "actions": [
              {
                "type": "when",
                "value": {
                  "expr": "$state.tool = \"PDF 합치기\""
                },
                "child": {
                  "type": "button",
                  "icon": "upload",
                  "icon_only": true,
                  "label": "열기",
                  "on_click": {
                    "pick_files": {
                      "accept": [
                        {
                          "mime": "application/pdf",
                          "extensions": [
                            "pdf"
                          ]
                        }
                      ],
                      "multiple": true,
                      "client": "load"
                    }
                  }
                }
              },
              {
                "type": "when",
                "value": {
                  "expr": "$state.tool = \"PDF 나누기\""
                },
                "child": {
                  "type": "button",
                  "icon": "upload",
                  "icon_only": true,
                  "label": "열기",
                  "on_click": {
                    "pick_files": {
                      "accept": [
                        {
                          "mime": "application/pdf",
                          "extensions": [
                            "pdf"
                          ]
                        }
                      ],
                      "multiple": false,
                      "client": "load"
                    }
                  }
                }
              },
              {
                "type": "when",
                "value": {
                  "expr": "$state.tool = \"PDF 회전\""
                },
                "child": {
                  "type": "button",
                  "icon": "upload",
                  "icon_only": true,
                  "label": "열기",
                  "on_click": {
                    "pick_files": {
                      "accept": [
                        {
                          "mime": "application/pdf",
                          "extensions": [
                            "pdf"
                          ]
                        }
                      ],
                      "multiple": false,
                      "client": "load"
                    }
                  }
                }
              },
              {
                "type": "when",
                "value": {
                  "expr": "$state.tool = \"그림을 PDF로\""
                },
                "child": {
                  "type": "button",
                  "icon": "upload",
                  "icon_only": true,
                  "label": "열기",
                  "on_click": {
                    "pick_files": {
                      "accept": [
                        {
                          "mime": "image/png",
                          "extensions": [
                            "png"
                          ]
                        },
                        {
                          "mime": "image/jpeg",
                          "extensions": [
                            "jpg",
                            "jpeg"
                          ]
                        },
                        {
                          "mime": "image/webp",
                          "extensions": [
                            "webp"
                          ]
                        },
                        {
                          "mime": "image/gif",
                          "extensions": [
                            "gif"
                          ]
                        }
                      ],
                      "multiple": true,
                      "client": "load"
                    }
                  }
                }
              },
              {
                "type": "when",
                "value": {
                  "expr": "$state.tool = \"PDF를 PNG로\""
                },
                "child": {
                  "type": "button",
                  "icon": "upload",
                  "icon_only": true,
                  "label": "열기",
                  "on_click": {
                    "pick_files": {
                      "accept": [
                        {
                          "mime": "application/pdf",
                          "extensions": [
                            "pdf"
                          ]
                        }
                      ],
                      "multiple": false,
                      "client": "load"
                    }
                  }
                }
              },
              {
                "type": "when",
                "value": {
                  "expr": "$state.tool = \"PDF에서 그림 추출\""
                },
                "child": {
                  "type": "button",
                  "icon": "upload",
                  "icon_only": true,
                  "label": "열기",
                  "on_click": {
                    "pick_files": {
                      "accept": [
                        {
                          "mime": "application/pdf",
                          "extensions": [
                            "pdf"
                          ]
                        }
                      ],
                      "multiple": false,
                      "client": "load"
                    }
                  }
                }
              },
              {
                "type": "when",
                "value": {
                  "expr": "$state.tool = \"PDF를 EPUB으로\""
                },
                "child": {
                  "type": "button",
                  "icon": "upload",
                  "icon_only": true,
                  "label": "열기",
                  "on_click": {
                    "pick_files": {
                      "accept": [
                        {
                          "mime": "application/pdf",
                          "extensions": [
                            "pdf"
                          ]
                        }
                      ],
                      "multiple": false,
                      "client": "load"
                    }
                  }
                }
              }
            ],
            "child": {
              "type": "stack",
              "direction": "column",
              "children": [
                {
                  "type": "stack",
                  "direction": "column",
                  "children": [
                    {
                      "type": "when",
                      "value": {
                        "client": "has_input"
                      },
                      "child": {
                        "type": "when",
                        "value": {
                          "expr": "($t := [{\"id\":\"merge-pdf\",\"name\":\"PDF 합치기\",\"input\":\"pdfs\",\"result\":\"file\"},{\"id\":\"split-pdf\",\"name\":\"PDF 나누기\",\"input\":\"pdf\",\"result\":\"file\"},{\"id\":\"rotate-pdf\",\"name\":\"PDF 회전\",\"input\":\"pdf\",\"result\":\"file\"},{\"id\":\"convert-to-pdf\",\"name\":\"그림을 PDF로\",\"input\":\"images\",\"result\":\"file\"},{\"id\":\"pdf-to-png\",\"name\":\"PDF를 PNG로\",\"input\":\"pdf\",\"result\":\"files\"},{\"id\":\"extract-images-from-pdf\",\"name\":\"PDF에서 그림 추출\",\"input\":\"pdf\",\"result\":\"files\"},{\"id\":\"pdf-to-epub\",\"name\":\"PDF를 EPUB으로\",\"input\":\"pdf\",\"result\":\"file\"}]; $s := $t[name = $state.tool][0]; $exists($s) ? $s : $t[0]).input = 'pdfs'"
                        },
                        "child": {
                          "type": "list",
                          "layout": "rows",
                          "items": {
                            "client": "input_rows"
                          },
                          "on_remove": {
                            "client": "remove"
                          },
                          "item_menu": [
                            {
                              "label": "위로",
                              "on_select": {
                                "client": "move_up"
                              }
                            },
                            {
                              "label": "아래로",
                              "on_select": {
                                "client": "move_down"
                              }
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "when",
                      "value": {
                        "client": "has_input"
                      },
                      "child": {
                        "type": "when",
                        "value": {
                          "expr": "($t := [{\"id\":\"merge-pdf\",\"name\":\"PDF 합치기\",\"input\":\"pdfs\",\"result\":\"file\"},{\"id\":\"split-pdf\",\"name\":\"PDF 나누기\",\"input\":\"pdf\",\"result\":\"file\"},{\"id\":\"rotate-pdf\",\"name\":\"PDF 회전\",\"input\":\"pdf\",\"result\":\"file\"},{\"id\":\"convert-to-pdf\",\"name\":\"그림을 PDF로\",\"input\":\"images\",\"result\":\"file\"},{\"id\":\"pdf-to-png\",\"name\":\"PDF를 PNG로\",\"input\":\"pdf\",\"result\":\"files\"},{\"id\":\"extract-images-from-pdf\",\"name\":\"PDF에서 그림 추출\",\"input\":\"pdf\",\"result\":\"files\"},{\"id\":\"pdf-to-epub\",\"name\":\"PDF를 EPUB으로\",\"input\":\"pdf\",\"result\":\"file\"}]; $s := $t[name = $state.tool][0]; $exists($s) ? $s : $t[0]).input = 'images'"
                        },
                        "child": {
                          "type": "list",
                          "layout": "rows",
                          "items": {
                            "client": "input_rows"
                          },
                          "on_remove": {
                            "client": "remove"
                          }
                        }
                      }
                    },
                    {
                      "type": "when",
                      "value": {
                        "client": "has_input"
                      },
                      "child": {
                        "type": "canvas",
                        "surface": "input",
                        "description": "입력 미리보기"
                      }
                    },
                    {
                      "type": "when",
                      "value": {
                        "client": "no_input"
                      },
                      "child": {
                        "type": "notice",
                        "kind": "info",
                        "message": {
                          "expr": "($t := [{\"id\":\"merge-pdf\",\"name\":\"PDF 합치기\",\"input\":\"pdfs\",\"result\":\"file\"},{\"id\":\"split-pdf\",\"name\":\"PDF 나누기\",\"input\":\"pdf\",\"result\":\"file\"},{\"id\":\"rotate-pdf\",\"name\":\"PDF 회전\",\"input\":\"pdf\",\"result\":\"file\"},{\"id\":\"convert-to-pdf\",\"name\":\"그림을 PDF로\",\"input\":\"images\",\"result\":\"file\"},{\"id\":\"pdf-to-png\",\"name\":\"PDF를 PNG로\",\"input\":\"pdf\",\"result\":\"files\"},{\"id\":\"extract-images-from-pdf\",\"name\":\"PDF에서 그림 추출\",\"input\":\"pdf\",\"result\":\"files\"},{\"id\":\"pdf-to-epub\",\"name\":\"PDF를 EPUB으로\",\"input\":\"pdf\",\"result\":\"file\"}]; $s := $t[name = $state.tool][0]; $exists($s) ? $s : $t[0]).input = 'images' ? '그림을 열어 주세요' : 'PDF를 열어 주세요'"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "when",
                  "value": {
                    "expr": "$state.tool = \"PDF 나누기\""
                  },
                  "child": {
                    "type": "section",
                    "title": "옵션",
                    "child": {
                      "type": "stack",
                      "direction": "column",
                      "gap": "small",
                      "children": [
                        {
                          "type": "input",
                          "value": {
                            "state": "o_split_pdf_pageRanges"
                          },
                          "on_change": {
                            "set_state": "o_split_pdf_pageRanges"
                          },
                          "label": "쪽 범위",
                          "placeholder": "예: 1,3-5"
                        },
                        {
                          "type": "when",
                          "value": {
                            "client": "has_input"
                          },
                          "child": {
                            "type": "text",
                            "style": "meta",
                            "value": {
                              "client": "page_info"
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "when",
                  "value": {
                    "expr": "$state.tool = \"PDF 회전\""
                  },
                  "child": {
                    "type": "section",
                    "title": "옵션",
                    "child": {
                      "type": "stack",
                      "direction": "column",
                      "gap": "small",
                      "children": [
                        {
                          "type": "select",
                          "value": {
                            "state": "o_rotate_pdf_rotationAngle"
                          },
                          "on_change": {
                            "set_state": "o_rotate_pdf_rotationAngle"
                          },
                          "label": "회전 각도",
                          "style": "segmented",
                          "options": [
                            {
                              "value": 90,
                              "label": "90°"
                            },
                            {
                              "value": 180,
                              "label": "180°"
                            },
                            {
                              "value": 270,
                              "label": "270°"
                            }
                          ]
                        },
                        {
                          "type": "toggle",
                          "value": {
                            "state": "o_rotate_pdf_applyToAllPages"
                          },
                          "on_change": {
                            "set_state": "o_rotate_pdf_applyToAllPages"
                          },
                          "label": "모든 쪽에 적용"
                        },
                        {
                          "type": "input",
                          "value": {
                            "state": "o_rotate_pdf_pageRanges"
                          },
                          "on_change": {
                            "set_state": "o_rotate_pdf_pageRanges"
                          },
                          "label": "쪽 범위",
                          "placeholder": "예: 1,3-5",
                          "read_only": {
                            "client": "lock_2_2"
                          }
                        },
                        {
                          "type": "when",
                          "value": {
                            "client": "has_input"
                          },
                          "child": {
                            "type": "text",
                            "style": "meta",
                            "value": {
                              "client": "page_info"
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "when",
                  "value": {
                    "expr": "$state.tool = \"그림을 PDF로\""
                  },
                  "child": {
                    "type": "section",
                    "title": "옵션",
                    "child": {
                      "type": "stack",
                      "direction": "column",
                      "gap": "small",
                      "children": [
                        {
                          "type": "select",
                          "value": {
                            "state": "o_convert_to_pdf_pageType"
                          },
                          "on_change": {
                            "set_state": "o_convert_to_pdf_pageType"
                          },
                          "label": "쪽 크기",
                          "style": "segmented",
                          "options": [
                            {
                              "value": "full",
                              "label": "그림 크기"
                            },
                            {
                              "value": "a4",
                              "label": "A4"
                            }
                          ]
                        },
                        {
                          "type": "select",
                          "value": {
                            "state": "o_convert_to_pdf_orientation"
                          },
                          "on_change": {
                            "set_state": "o_convert_to_pdf_orientation"
                          },
                          "label": "방향",
                          "style": "segmented",
                          "options": [
                            {
                              "value": "portrait",
                              "label": "세로"
                            },
                            {
                              "value": "landscape",
                              "label": "가로"
                            }
                          ],
                          "disabled": {
                            "client": "lock_3_1"
                          }
                        },
                        {
                          "type": "input",
                          "value": {
                            "state": "o_convert_to_pdf_scale"
                          },
                          "on_change": {
                            "set_state": "o_convert_to_pdf_scale"
                          },
                          "label": "크기 (%)",
                          "kind": "number",
                          "spin": true,
                          "min": 10,
                          "max": 100,
                          "step": 1,
                          "read_only": {
                            "client": "lock_3_2"
                          }
                        },
                        {
                          "type": "when",
                          "value": {
                            "client": "has_result"
                          },
                          "child": {
                            "type": "text",
                            "style": "meta",
                            "value": {
                              "client": "image_info"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "type": "section",
            "title": "결과",
            "actions": [
              {
                "type": "when",
                "value": {
                  "client": "format_pdf"
                },
                "child": {
                  "type": "button",
                  "icon": "download",
                  "icon_only": true,
                  "label": "저장",
                  "on_click": {
                    "save_file": {
                      "suggested_name": {
                        "client": "filename"
                      },
                      "mime": "application/pdf",
                      "client": "save"
                    }
                  },
                  "disabled": {
                    "client": "no_result"
                  }
                }
              },
              {
                "type": "when",
                "value": {
                  "client": "format_epub"
                },
                "child": {
                  "type": "button",
                  "icon": "download",
                  "icon_only": true,
                  "label": "저장",
                  "on_click": {
                    "save_file": {
                      "suggested_name": {
                        "client": "filename"
                      },
                      "mime": "application/epub+zip",
                      "client": "save"
                    }
                  },
                  "disabled": {
                    "client": "no_result"
                  }
                }
              },
              {
                "type": "when",
                "value": {
                  "client": "format_zip"
                },
                "child": {
                  "type": "button",
                  "icon": "download",
                  "icon_only": true,
                  "label": "저장",
                  "on_click": {
                    "save_file": {
                      "suggested_name": {
                        "client": "filename"
                      },
                      "mime": "application/zip",
                      "client": "save"
                    }
                  },
                  "disabled": {
                    "client": "no_result"
                  }
                }
              },
              {
                "type": "when",
                "value": {
                  "client": "format_png"
                },
                "child": {
                  "type": "button",
                  "icon": "download",
                  "icon_only": true,
                  "label": "저장",
                  "on_click": {
                    "save_file": {
                      "suggested_name": {
                        "client": "filename"
                      },
                      "mime": "image/png",
                      "client": "save"
                    }
                  },
                  "disabled": {
                    "client": "no_result"
                  }
                }
              },
              {
                "type": "when",
                "value": {
                  "client": "no_result"
                },
                "child": {
                  "type": "when",
                  "value": {
                    "expr": "$state.tool = \"PDF 합치기\""
                  },
                  "child": {
                    "type": "button",
                    "icon": "download",
                    "icon_only": true,
                    "label": "저장",
                    "on_click": {
                      "save_file": {
                        "suggested_name": {
                          "client": "filename"
                        },
                        "mime": "application/pdf",
                        "client": "save"
                      }
                    },
