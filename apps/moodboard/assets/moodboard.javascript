(async()=>{if(typeof DecompressionStream==="undefined")throw new Error("DecompressionStream을 쓸 수 없습니다");const k=window.kaleidoscope,t=async i=>new TextDecoder().decode(await k.assets.bytes(i)).trim();const m=JSON.parse(await t("moodboard-manifest"));globalThis.MOODBOARD_MANIFEST=m;const s=(await Promise.all(m.client.map(([i])=>t(i).then(x=>JSON.parse(x.replace(/;$/,"")))))).join("");const b=Uint8Array.from(atob(s),c=>c.charCodeAt(0));(0,eval)(await new Response(new Blob([b]).stream().pipeThrough(new DecompressionStream("gzip"))).text())})().catch(e=>{console.error("moodboard: 앱 코드를 불러오지 못했습니다",e);try{window.kaleidoscope.publish({notice:"앱을 불러오지 못했어요: "+(e&&e.message||String(e)),has_notice:true})}catch(_){}});
