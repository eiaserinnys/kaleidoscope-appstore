                            {
                              "type": "button",
                              "label": "$1,000",
                              "on_click": [
                                {
                                  "set_state": "amount_usd",
                                  "value": {
                                    "expr": "1000"
                                  }
                                },
                                {
                                  "set_state": "amount_local",
                                  "value": {
                                    "expr": "$round((1000) * ($lookup($data.fx_asset_quote.rates, $state.currency)), 2)"
                                  }
                                }
                              ]
                            },
                            {
                              "type": "button",
                              "label": "1단위 자산",
                              "on_click": [
                                {
                                  "set_state": "amount_usd",
                                  "value": {
                                    "expr": "$number($data.asset_tickers[symbol = ($state.asset & 'USDT')].lastPrice)"
                                  }
                                },
                                {
                                  "set_state": "amount_local",
                                  "value": {
                                    "expr": "$round(($number($data.asset_tickers[symbol = ($state.asset & 'USDT')].lastPrice)) * ($lookup($data.fx_asset_quote.rates, $state.currency)), 2)"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "type": "text",
                "style": "meta",
                "value": {
                  "expr": "$state.amount_usd != null ? ($rate := ($lookup($data.fx_asset_quote.rates, $state.currency)); $ppp := ($id := $lookup({\"KRW\":\"KOR\",\"EUR\":\"DEU\",\"JPY\":\"JPN\",\"GBP\":\"GBR\",\"CNY\":\"CHN\",\"CHF\":\"CHE\",\"CAD\":\"CAN\",\"AUD\":\"AUS\"}, $state.currency); $data.macro_ppp[1][countryiso3code = $id and value != null][0].value); '$' & $formatNumber($state.amount_usd, '#,##0.##') & ' = ' & $formatNumber($state.amount_usd * $rate, '#,##0.##') & ' ' & $state.currency & ' · ' & $string($round($state.amount_usd / $number($data.asset_tickers[symbol = ($state.asset & 'USDT')].lastPrice), 4)) & ' ' & $state.asset & ' · PPP $' & $formatNumber($state.amount_usd * $rate / $ppp, '#,##0.##')) : ''"
                }
              }
            ]
          },
          {
            "type": "section",
            "title": {
              "expr": "$state.asset & ' / ' & ($state.quote_unit = 'LOCAL' ? $state.currency : 'USD') & ' 시세 (30봉)'"
            },
            "meta": {
              "expr": "$state.selected_candle ? ($state.selected_candle.x & ' · 시 ' & $string($state.selected_candle.open) & ' 고 ' & $string($state.selected_candle.high) & ' 저 ' & $string($state.selected_candle.low) & ' 종 ' & $string($state.selected_candle.close)) : $data_meta.asset_candles.updated_time"
            },
            "child": {
              "type": "chart",
              "kind": "candlestick",
              "height": "medium",
              "series": {
                "expr": "($rate := $state.quote_unit = 'LOCAL' ? ($lookup($data.fx_asset_quote.rates, $state.currency)) : 1; [{\"key\":\"price\",\"name\":$state.asset,\"points\":[$map($data.asset_candles,function($k){{\"x\":$fromMillis($k[0], $state.interval = '4h' ? '[M01]-[D01] [H01]:[m01]' : '[M01]-[D01]'),\"open\":$round($number($k[1])*$rate,2),\"high\":$round($number($k[2])*$rate,2),\"low\":$round($number($k[3])*$rate,2),\"close\":$round($number($k[4])*$rate,2)}})]}])"
              },
              "on_select": [
                {
                  "set_state": "selected_candle",
                  "value": {
                    "expr": "$item"
                  }
                }
              ]
            }
          },
          {
            "type": "tabs",
            "selected": {
              "state": "table_tab"
            },
            "on_change": {
              "set_state": "table_tab"
            },
            "tabs": [
              {
                "label": "통화별 환율 · 구매력",
                "child": {
                  "type": "table",
                  "rows": {
                    "expr": "($rows := [{\"code\":\"KRW\",\"name\":\"대한민국 원\",\"ppp\":\"KOR\",\"cpi\":\"KOR\"},{\"code\":\"EUR\",\"name\":\"유로\",\"ppp\":\"DEU\",\"cpi\":\"EMU\"},{\"code\":\"JPY\",\"name\":\"일본 엔\",\"ppp\":\"JPN\",\"cpi\":\"JPN\"},{\"code\":\"GBP\",\"name\":\"영국 파운드\",\"ppp\":\"GBR\",\"cpi\":\"GBR\"},{\"code\":\"CNY\",\"name\":\"중국 위안\",\"ppp\":\"CHN\",\"cpi\":\"CHN\"},{\"code\":\"CHF\",\"name\":\"스위스 프랑\",\"ppp\":\"CHE\",\"cpi\":\"CHE\"},{\"code\":\"CAD\",\"name\":\"캐나다 달러\",\"ppp\":\"CAN\",\"cpi\":\"CAN\"},{\"code\":\"AUD\",\"name\":\"호주 달러\",\"ppp\":\"AUS\",\"cpi\":\"AUS\"}]; $cut := $fromMillis($toMillis($data.fx_asset_quote.date & 'T00:00:00Z') - 2592000000, '[Y0001]-[M01]-[D01]'); $dates := $sort($keys($data.fx_series.rates))[$ >= $cut]; $map($rows,function($r){(\n $code := $r.code; $rate := $lookup($data.fx_asset_quote.rates,$code);\n $values := [$map($dates,function($d){$lookup($lookup($data.fx_series.rates,$d),$code)})];\n $ppp := $data.macro_ppp[1][countryiso3code = $r.ppp and value != null][0].value;\n $cpi := $data.macro_cpi[1][countryiso3code = $r.cpi and value != null][0].value;\n {\"key\":$code,\"currency\":$code & \" · \" & $r.name,\"asset_quote\":$lookup($data.fx_asset_quote.rates,$code)*$number($data.asset_tickers[symbol = ($state.asset & 'USDT')].lastPrice),\"fx_rate\":$rate,\"fx_delta\":($values[$count($values)-1]-$values[0])/$values[0]*100,\"fx_spark\":$values,\"ppp_gap\":($rate-$ppp)/$ppp*100,\"cpi\":$cpi != null ? $formatNumber($cpi, \"0.00\") & \"%\" : \"—\"})}))"
                  },
                  "columns": [
                    {
                      "field": "currency",
                      "label": "통화",
                      "format": "text",
                      "width": "medium"
                    },
                    {
                      "field": "asset_quote",
                      "label": "자산 환산가",
                      "format": "number",
                      "width": "medium"
                    },
                    {
                      "field": "fx_rate",
                      "label": "명목 환율",
                      "format": "number",
                      "width": "narrow"
                    },
                    {
                      "field": "fx_delta",
                      "label": "30일 변동",
                      "format": "delta",
                      "width": "narrow"
                    },
                    {
                      "field": "fx_spark",
                      "label": "환율 추이",
                      "format": "sparkline",
                      "width": "narrow"
                    },
                    {
                      "field": "ppp_gap",
                      "label": "PPP 괴리",
                      "format": "delta",
                      "width": "narrow"
                    },
                    {
                      "field": "cpi",
                      "label": "물가 CPI",
                      "format": "text",
                      "width": "narrow"
                    }
                  ],
                  "selected": {
                    "state": "currency"
                  },
                  "on_select": [
                    {
                      "set_state": "currency"
                    },
                    {
                      "set_state": "amount_local",
                      "value": {
                        "expr": "$state.amount_usd != null ? $round($state.amount_usd * ($lookup($data.fx_asset_quote.rates, $event)), 2) : null"
                      }
                    },
                    {
                      "set_state": "selected_candle",
                      "value": null
                    }
                  ]
                }
              },
              {
                "label": "글로벌 자산 시세",
                "child": {
                  "type": "table",
                  "rows": {
                    "expr": "($names := {\"BTC\":\"Bitcoin\",\"ETH\":\"Ethereum\",\"SOL\":\"Solana\",\"XRP\":\"XRP\",\"BNB\":\"BNB\",\"DOGE\":\"Dogecoin\",\"ADA\":\"Cardano\",\"AVAX\":\"Avalanche\"}; $trends := {\"BTC\":$data.trend_btc,\"ETH\":$data.trend_eth,\"SOL\":$data.trend_sol,\"XRP\":$data.trend_xrp,\"BNB\":$data.trend_bnb,\"DOGE\":$data.trend_doge,\"ADA\":$data.trend_ada,\"AVAX\":$data.trend_avax}; $map($data.asset_tickers,function($t){(\n $asset := $substringBefore($t.symbol,'USDT'); $history := $lookup($trends,$asset); $usd := $number($t.lastPrice); $local := $usd * ($lookup($data.fx_asset_quote.rates, $state.currency));\n {\"key\":$asset,\"asset\":$asset & \" · \" & $lookup($names,$asset),\"local_price\":$round($local, $local >= 100 ? 2 : 4),\"usd_price\":$round($usd, $usd >= 100 ? 2 : 4),\"change_24h\":$number($t.priceChangePercent),\"spark_24h\":[$map($history,function($k){$number($k[4])})]})}))"
                  },
                  "columns": [
                    {
                      "field": "asset",
                      "label": "자산",
                      "format": "text",
                      "width": "medium"
                    },
                    {
                      "field": "local_price",
                      "label": "현지 시세",
                      "format": "number",
                      "width": "medium"
                    },
                    {
                      "field": "usd_price",
                      "label": "USD",
                      "format": "number",
                      "width": "narrow"
                    },
                    {
                      "field": "change_24h",
                      "label": "24h 등락",
                      "format": "delta",
                      "width": "narrow"
                    },
                    {
                      "field": "spark_24h",
                      "label": "24h 추이",
                      "format": "sparkline",
                      "width": "narrow"
                    }
                  ],
                  "selected": {
                    "state": "asset"
                  },
                  "on_select": [
                    {
                      "set_state": "asset"
                    },
                    {
                      "set_state": "selected_candle",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
