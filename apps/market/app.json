{
  "id": "market",
  "name": "시세와 환율",
  "description": "글로벌 자산 시세와 통화 환율, 구매력 지표를 한눈에 비교하고 환산합니다",
  "icon": {
    "asset": "market-icon",
    "version": 2
  },
  "requires": {
    "blocks": 26,
    "modules": {
      "http": 1,
      "assets": 1
    }
  },
  "permissions": [
    {
      "module": "http",
      "id": "binance",
      "label": "글로벌 암호화폐 시세 (Binance)",
      "base_url": "https://api.binance.com",
      "paths": [
        "/api/v3/ticker/24hr",
        "/api/v3/klines"
      ]
    },
    {
      "module": "http",
      "id": "frankfurter",
      "label": "유럽중앙은행 통화 환율 (Frankfurter)",
      "base_url": "https://api.frankfurter.dev",
      "paths": [
        "/v1/latest",
        "/v1/2026-09-15.."
      ]
    },
    {
      "module": "http",
      "id": "worldbank",
      "label": "세계은행 물가·구매력 지표 (World Bank)",
      "base_url": "https://api.worldbank.org",
      "paths": [
        "/v2/country/KOR;USA;EMU;DEU;JPN;GBR;CHN;CHE;CAN;AUS/indicator/FP.CPI.TOTL.ZG",
        "/v2/country/KOR;USA;DEU;JPN;GBR;CHN;CHE;CAN;AUS/indicator/PA.NUS.PPP"
      ]
    }
  ],
  "assets": [
    {
      "id": "market-icon",
      "version": 2
    }
  ],
  "state": {
    "asset": "BTC",
    "currency": "KRW",
    "interval": "1d",
    "quote_unit": "LOCAL",
    "amount_usd": 1000,
    "amount_local": null,
    "selected_candle": null,
    "table_tab": 0
  },
  "sources": {
    "asset_tickers": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/ticker/24hr",
      "query": {
        "symbols": "[\"BTCUSDT\",\"ETHUSDT\",\"SOLUSDT\",\"XRPUSDT\",\"BNBUSDT\",\"DOGEUSDT\",\"ADAUSDT\",\"AVAXUSDT\"]"
      },
      "refresh_secs": 60
    },
    "asset_candles": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/klines",
      "query": {
        "symbol": {
          "expr": "$state.asset & 'USDT'"
        },
        "interval": {
          "state": "interval"
        },
        "limit": "30"
      },
      "refresh_secs": 60
    },
    "fx_asset_quote": {
      "kind": "request",
      "permission": "frankfurter",
      "path": "/v1/latest",
      "query": {
        "base": "USD",
        "symbols": "KRW,EUR,JPY,GBP,CNY,CHF,CAD,AUD"
      },
      "refresh_secs": 3600
    },
    "fx_series": {
      "kind": "request",
      "permission": "frankfurter",
      "path": "/v1/2026-09-15..",
      "query": {
        "base": {
          "expr": "$data.fx_asset_quote.base"
        },
        "symbols": "KRW,EUR,JPY,GBP,CNY,CHF,CAD,AUD"
      },
      "refresh_secs": 3600
    },
    "macro_cpi": {
      "kind": "request",
      "permission": "worldbank",
      "path": "/v2/country/KOR;USA;EMU;DEU;JPN;GBR;CHN;CHE;CAN;AUS/indicator/FP.CPI.TOTL.ZG",
      "query": {
        "format": "json",
        "per_page": "100",
        "date": {
          "expr": "'2020:' & $substring($data.fx_asset_quote.date, 0, 4)"
        }
      }
    },
    "macro_ppp": {
      "kind": "request",
      "permission": "worldbank",
      "path": "/v2/country/KOR;USA;DEU;JPN;GBR;CHN;CHE;CAN;AUS/indicator/PA.NUS.PPP",
      "query": {
        "format": "json",
        "per_page": "100",
        "date": {
          "expr": "'2020:' & $substring($data.fx_asset_quote.date, 0, 4)"
        }
      }
    },
    "trend_btc": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/klines",
      "query": {
        "symbol": "BTCUSDT",
        "interval": "1h",
        "limit": "24"
      },
      "refresh_secs": 300
    },
    "trend_eth": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/klines",
