        "symbol": "ADAUSDT",
        "interval": "1h",
        "limit": "24"
      },
      "refresh_secs": 300
    },
    "trend_avax": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/klines",
      "query": {
        "symbol": "AVAXUSDT",
        "interval": "1h",
        "limit": "24"
      },
      "refresh_secs": 300
    }
