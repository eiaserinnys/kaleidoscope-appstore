            "columns": 4,
            "items": {
              "expr": "(\n $chg := $number($data.asset_tickers[symbol = ($state.asset & 'USDT')].priceChangePercent); $p := $number($data.asset_tickers[symbol = ($state.asset & 'USDT')].lastPrice); $rate := ($lookup($data.fx_asset_quote.rates, $state.currency)); $ppp := ($id := $lookup({\"KRW\":\"KOR\",\"EUR\":\"DEU\",\"JPY\":\"JPN\",\"GBP\":\"GBR\",\"CNY\":\"CHN\",\"CHF\":\"CHE\",\"CAD\":\"CAN\",\"AUD\":\"AUS\"}, $state.currency); $data.macro_ppp[1][countryiso3code = $id and value != null][0].value); $cpi := ($id := $lookup({\"KRW\":\"KOR\",\"EUR\":\"EMU\",\"JPY\":\"JPN\",\"GBP\":\"GBR\",\"CNY\":\"CHN\",\"CHF\":\"CHE\",\"CAD\":\"CAN\",\"AUD\":\"AUS\"}, $state.currency); $data.macro_cpi[1][countryiso3code = $id and value != null][0]);\n $us := $data.macro_cpi[1][countryiso3code = 'USA' and value != null][0].value;\n $cut := $fromMillis($toMillis($data.fx_asset_quote.date & 'T00:00:00Z') - 2592000000, '[Y0001]-[M01]-[D01]'); $keys := $sort($keys($data.fx_series.rates))[$ >= $cut]; $first := $lookup($lookup($data.fx_series.rates,$keys[0]),$state.currency); $last := $lookup($lookup($data.fx_series.rates,$keys[$count($keys)-1]),$state.currency);\n [{\"label\":\"1 \" & $state.asset & \" (\" & $state.currency & \")\", \"value\":$formatNumber($p*$rate, \"#,##0.##\"),\"unit\":$state.currency,\"featured\":true,\"subtext\":\"USD \" & $formatNumber($p, \"#,##0.##\") & \" · 고 \" & $formatNumber($number($data.asset_tickers[symbol = ($state.asset & 'USDT')].highPrice), \"#,##0.##\") & \" / 저 \" & $formatNumber($number($data.asset_tickers[symbol = ($state.asset & 'USDT')].lowPrice), \"#,##0.##\"),\"badge\":($chg > 0 ? \"+\" : \"\") & $formatNumber($chg, \"0.00\") & \"%\"},\n {\"label\":\"USD / \" & $state.currency,\"value\":$formatNumber($rate, \"#,##0.####\"),\"unit\":$state.currency,\"subtext\":\"30일 전 대비 · \" & $data.fx_asset_quote.date,\"badge\":$string($round(($last-$first)/$first*100,2)) & \"%\"},\n {\"label\":\"PPP 구매력 환율\",\"value\":$formatNumber($ppp, \"#,##0.##\"),\"unit\":$state.currency,\"subtext\":\"자산 실질 가치 $\" & $formatNumber($p*$rate/$ppp, \"#,##0.##\"),\"badge\":$string($round(($rate-$ppp)/$ppp*100,2)) & \"%\"},\n {\"label\":\"연간 물가 CPI\",\"value\":$round($cpi.value,2),\"unit\":\"%\",\"subtext\":$cpi.date & \"년\", \"badge\":\"US 대비 \" & $formatNumber($cpi.value-$us, \"0.00\") & \"%p\"}])"
            }
