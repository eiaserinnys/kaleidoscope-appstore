B2C8\uB2E4. \uBB38\uC790\uC5F4\uC740 \uD070\uB530\uC634\uD45C\uB85C \uAC10\uC2F8\uACE0 \uAC12\uC758 \uD45C\uAE30\uB97C \uD655\uC778\uD558\uC138\uC694."),`${I}\uD589 ${e}\uC5F4\uC5D0\uC11C ${S}`}var Bo={"URI malformed":"URL \uC778\uCF54\uB529\uC774 \uC62C\uBC14\uB974\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uD37C\uC13C\uD2B8 \uC778\uCF54\uB529\uC744 \uD655\uC778\uD558\uC138\uC694.","Invalid URL":"URL\uC744 \uC77D\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uC8FC\uC18C\uB97C \uD655\uC778\uD558\uC138\uC694.","URLs with credentials are not supported":"\uC544\uC774\uB514\uC640 \uBE44\uBC00\uBC88\uD638\uAC00 \uD3EC\uD568\uB41C URL\uC740 \uC9C0\uC6D0\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.","Length value must be a positive number.":"\uAE38\uC774\uB294 \uC591\uC218\uC5EC\uC57C \uD569\uB2C8\uB2E4.","Length must be a positive number":"\uAE38\uC774\uB294 \uC591\uC218\uC5EC\uC57C \uD569\uB2C8\uB2E4.","Number of chunks must be a positive number":"\uC870\uAC01 \uC218\uB294 \uC591\uC218\uC5EC\uC57C \uD569\uB2C8\uB2E4.","Rotation step must be greater than zero.":"\uC774\uB3D9 \uCE78 \uC218\uB294 0\uBCF4\uB2E4 \uCEE4\uC57C \uD569\uB2C8\uB2E4.","Rotation step contains non-digits.":"\uC774\uB3D9 \uCE78 \uC218\uC5D0 \uC22B\uC790\uB9CC \uC785\uB825\uD558\uC138\uC694.","Start index must be greater than zero.":"\uC2DC\uC791 \uC704\uCE58\uB294 0\uBCF4\uB2E4 \uCEE4\uC57C \uD569\uB2C8\uB2E4.","Length value must be greater than or equal to zero.":"\uAE38\uC774\uB294 0 \uC774\uC0C1\uC774\uC5B4\uC57C \uD569\uB2C8\uB2E4.","Number of copies cannot be negative":"\uBCF5\uC81C \uD69F\uC218\uB294 \uC74C\uC218\uC77C \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.","Number of copies must be a valid number":"\uBCF5\uC81C \uD69F\uC218\uC5D0 \uC22B\uC790\uB97C \uC785\uB825\uD558\uC138\uC694.","Length value cannot be negative":"\uAE38\uC774\uB294 \uC74C\uC218\uC77C \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.","Indicator length is greater than truncation length":"\uC0DD\uB7B5 \uD45C\uC2DC\uAC00 \uC790\uB97C \uAE38\uC774\uBCF4\uB2E4 \uAE41\uB2C8\uB2E4.","Enter a valid censor symbol (non-alphanumeric or emoji)":"\uAE00\uC790\uB098 \uC22B\uC790\uAC00 \uC544\uB2CC \uAC00\uB9B4 \uAE30\uD638\uB97C \uC785\uB825\uD558\uC138\uC694.","No <table> element found in the input":"\uC785\uB825\uC5D0\uC11C HTML \uD45C\uB97C \uCC3E\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.","No table data could be parsed from the input":"\uC785\uB825\uC5D0\uC11C \uD45C\uB97C \uC77D\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."};Object.assign(Bo,{"Length value isn't a value number.":"\uAE38\uC774\uAC00 \uC22B\uC790\uAC00 \uC544\uB2D9\uB2C8\uB2E4. \uAE38\uC774\uC5D0 \uC591\uC218\uB97C \uC785\uB825\uD558\uC138\uC694.","Array is empty":"\uC815\uB82C\uD560 \uBC30\uC5F4\uC774 \uBE44\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. \uD56D\uBAA9\uC744 \uB123\uC73C\uC138\uC694.","Input must be a JSON object or array of objects":"\uD0A4\uB97C \uC815\uB82C\uD560 \uAC1D\uCCB4\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4. JSON \uAC1D\uCCB4\uB098 \uAC1D\uCCB4 \uBC30\uC5F4\uC744 \uC785\uB825\uD558\uC138\uC694.","Input must be a JSON array":"\uAC12\uC73C\uB85C \uC815\uB82C\uD558\uB824\uBA74 \uBC30\uC5F4\uC774 \uD544\uC694\uD569\uB2C8\uB2E4. \uD0A4\uB97C \uC815\uB82C\uD558\uB824\uBA74 \uC815\uB82C \uAE30\uC900\uC744 \uD0A4\uB85C \uBC14\uAFB8\uC138\uC694.","Invalid JavaScript object/array":"\uC785\uB825\uC774 \uC790\uBC14\uC2A4\uD06C\uB9BD\uD2B8 \uAC1D\uCCB4\uB098 \uBC30\uC5F4 \uD615\uC2DD\uC774 \uC544\uB2D9\uB2C8\uB2E4. \uD0A4\uC640 \uAC12, \uC27C\uD45C\uC640 \uAD04\uD638\uB97C \uD655\uC778\uD558\uC138\uC694.","JSON root value must be an object or array.":"XML\uB85C \uBC14\uAFC0 \uCD5C\uC0C1\uC704 \uAC12\uC740 \uAC1D\uCCB4\uB098 \uBC30\uC5F4\uC774\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uAC1D\uCCB4\uB098 \uBC30\uC5F4\uC744 \uC785\uB825\uD558\uC138\uC694.","JSON input must be an object or array of objects, not a bare primitive.":"CSV\uB85C \uBC14\uAFC0 \uAC12\uC740 \uAC1D\uCCB4\uB098 \uAC1D\uCCB4 \uBC30\uC5F4\uC774\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uBB38\uC790\uC5F4\uC774\uB098 \uC22B\uC790\uB97C \uAC1D\uCCB4\uB85C \uAC10\uC2F8\uC138\uC694.","No CSV delimiter.":"CSV \uAD6C\uBD84 \uBB38\uC790\uAC00 \uBE44\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. \uC27C\uD45C \uAC19\uC740 \uAD6C\uBD84 \uBB38\uC790\uB97C \uC785\uB825\uD558\uC138\uC694.","No data found in the provided JSON.":"CSV\uB85C \uBC14\uAFC0 JSON\uC5D0 \uB370\uC774\uD130\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4. \uAC1D\uCCB4\uB098 \uBC30\uC5F4\uC5D0 \uAC12\uC744 \uB123\uC73C\uC138\uC694.","Indent spaces must be greater than zero":"\uB4E4\uC5EC\uC4F0\uAE30 \uACF5\uBC31 \uC218\uAC00 0 \uC774\uD558\uC785\uB2C8\uB2E4. 1 \uC774\uC0C1\uC744 \uC785\uB825\uD558\uC138\uC694.","Message number must be greater than 0":"\uD45C\uC2DC\uD560 \uBA54\uC2DC\uC9C0 \uC218\uAC00 0 \uC774\uD558\uC785\uB2C8\uB2E4. 1 \uC774\uC0C1\uC744 \uC785\uB825\uD558\uC138\uC694.","Invalid column positions. Check headers or positions.":"\uB9DE\uBC14\uAFC0 \uC5F4\uC744 \uCC3E\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uC785\uB825\uC5D0 \uC788\uB294 \uBA38\uB9AC\uAE00\uC774\uB098 \uC5F4 \uBC88\uD638\uB97C \uACE0\uB974\uC138\uC694.","Columns position must be greater than zero ":"\uC5F4 \uBC88\uD638\uAC00 0 \uC774\uD558\uC785\uB2C8\uB2E4. 1\uBD80\uD130 \uC2DC\uC791\uD558\uB294 \uC5F4 \uBC88\uD638\uB97C \uC785\uB825\uD558\uC138\uC694.","Accuracy contains non digits.":"\uC18C\uC218 \uC790\uB9BF\uC218\uC5D0 \uC22B\uC790\uAC00 \uC544\uB2CC \uBB38\uC790\uAC00 \uC788\uC2B5\uB2C8\uB2E4. 0 \uC774\uC0C1\uC758 \uC815\uC218\uB97C \uC785\uB825\uD558\uC138\uC694.","Month must be between 1 and 12":"\uC6D4\uC774 1~12 \uBC94\uC704\uB97C \uBC97\uC5B4\uB0AC\uC2B5\uB2C8\uB2E4. \uBAA9\uB85D\uC5D0\uC11C \uC6D4\uC744 \uACE0\uB974\uC138\uC694.","Day must be between 1 and 31":"\uC77C\uC774 1~31 \uBC94\uC704\uB97C \uBC97\uC5B4\uB0AC\uC2B5\uB2C8\uB2E4. \uBAA9\uB85D\uC5D0\uC11C \uC77C\uC744 \uACE0\uB974\uC138\uC694.","Invalid day for the selected month":"\uC120\uD0DD\uD55C \uC6D4\uC5D0 \uC5C6\uB294 \uB0A0\uC9DC\uC785\uB2C8\uB2E4. \uADF8 \uB2EC\uC758 \uB9C8\uC9C0\uB9C9 \uB0A0 \uC774\uD558\uB85C \uACE0\uB974\uC138\uC694.","Invalid weekday":"\uC694\uC77C\uC744 \uCC3E\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uBAA9\uB85D\uC5D0\uC11C \uC694\uC77C\uC744 \uACE0\uB974\uC138\uC694.","Years must be integers between 1 and 9999":"\uC5F0\uB3C4\uAC00 1~9999 \uBC94\uC704\uC758 \uC815\uC218\uAC00 \uC544\uB2D9\uB2C8\uB2E4. \uC2DC\uC791 \uC5F0\uB3C4\uC640 \uB05D \uC5F0\uB3C4\uB97C \uACE0\uCE58\uC138\uC694.","Start year must be less than or equal to end year":"\uC2DC\uC791 \uC5F0\uB3C4\uAC00 \uB05D \uC5F0\uB3C4\uBCF4\uB2E4 \uD07D\uB2C8\uB2E4. \uC5F0\uB3C4 \uBC94\uC704\uB97C \uBC14\uB85C\uC7A1\uC73C\uC138\uC694.","All fields are required":"\uB0A0\uC9DC\uC640 \uC5F0\uB3C4 \uBC94\uC704\uC5D0 \uBE48 \uAC12\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uC6D4, \uC77C, \uC694\uC77C\uACFC \uC2DC\uC791\xB7\uB05D \uC5F0\uB3C4\uB97C \uCC44\uC6B0\uC138\uC694.","End date must be after start date":"\uB05D \uB0A0\uC9DC\uAC00 \uC2DC\uC791 \uB0A0\uC9DC\uBCF4\uB2E4 \uBE60\uB985\uB2C8\uB2E4. \uC2DC\uC791\uACFC \uB05D \uB0A0\uC9DC\uB97C \uD655\uC778\uD558\uC138\uC694.","Invalid timezone format":"\uC2DC\uAC04\uB300 \uC774\uB984\uC774 \uC62C\uBC14\uB974\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uBAA9\uB85D\uC5D0\uC11C \uB3C4\uC2DC \uC2DC\uAC04\uB300\uB97C \uACE0\uB974\uC138\uC694.","Invalid date or time format":"\uB0A0\uC9DC\uB098 \uC2DC\uAC01\uC744 \uC77D\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uB0A0\uC9DC\uC640 \uC2DC\uAC01\uC744 \uB2E4\uC2DC \uACE0\uB974\uC138\uC694.","Invalid time value":"\uB0A0\uC9DC\uB098 \uC2DC\uAC01\uC774 \uC720\uD6A8\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uB0A0\uC9DC\uC640 \uC2DC\uAC01\uC744 \uB2E4\uC2DC \uACE0\uB974\uC138\uC694.","Minimum port must be less than maximum port":"\uCD5C\uC18C \uD3EC\uD2B8\uAC00 \uCD5C\uB300 \uD3EC\uD2B8 \uC774\uC0C1\uC785\uB2C8\uB2E4. \uCD5C\uC18C \uD3EC\uD2B8\uB97C \uB354 \uC791\uAC8C \uC785\uB825\uD558\uC138\uC694.","Ports must be between 1 and 65535":"\uD3EC\uD2B8\uAC00 1~65535 \uBC94\uC704\uB97C \uBC97\uC5B4\uB0AC\uC2B5\uB2C8\uB2E4. \uBC94\uC704 \uC548\uC758 \uD3EC\uD2B8\uB97C \uC785\uB825\uD558\uC138\uC694.","Count must be greater than 0":"\uB9CC\uB4E4 \uAC1C\uC218\uAC00 0 \uC774\uD558\uC785\uB2C8\uB2E4. 1 \uC774\uC0C1\uC744 \uC785\uB825\uD558\uC138\uC694.","Count cannot exceed 1,000":"\uB9CC\uB4E4 \uD3EC\uD2B8 \uC218\uAC00 1,000\uAC1C\uB97C \uB118\uC2B5\uB2C8\uB2E4. \uAC1C\uC218\uB97C \uC904\uC774\uC138\uC694.","Count cannot exceed 10,000":"\uB9CC\uB4E4 \uC22B\uC790 \uC218\uAC00 10,000\uAC1C\uB97C \uB118\uC2B5\uB2C8\uB2E4. \uAC1C\uC218\uB97C \uC904\uC774\uC138\uC694.","Range cannot exceed 1,000,000":"\uC22B\uC790 \uBC94\uC704\uC758 \uCC28\uC774\uAC00 1,000,000\uC744 \uB118\uC2B5\uB2C8\uB2E4. \uCD5C\uC19F\uAC12\uACFC \uCD5C\uB313\uAC12\uC758 \uCC28\uC774\uB97C \uC904\uC774\uC138\uC694.","Minimum value must be less than maximum value":"\uCD5C\uC19F\uAC12\uC774 \uCD5C\uB313\uAC12 \uC774\uC0C1\uC785\uB2C8\uB2E4. \uCD5C\uC19F\uAC12\uC744 \uB354 \uC791\uAC8C \uC785\uB825\uD558\uC138\uC694.","Please enter valid numbers for min, max, and count":"\uCD5C\uC19F\uAC12, \uCD5C\uB313\uAC12\uC774\uB098 \uAC1C\uC218\uAC00 \uC22B\uC790\uAC00 \uC544\uB2D9\uB2C8\uB2E4. \uC138 \uCE78\uC5D0 \uC22B\uC790\uB97C \uC785\uB825\uD558\uC138\uC694.","Count exceeds the number of unique values available in this range":"\uC911\uBCF5 \uC5C6\uC774 \uB9CC\uB4E4 \uC218 \uC788\uB294 \uC22B\uC790\uBCF4\uB2E4 \uC694\uCCAD\uD55C \uAC1C\uC218\uAC00 \uB9CE\uC2B5\uB2C8\uB2E4. \uAC1C\uC218\uB97C \uC904\uC774\uAC70\uB098 \uC911\uBCF5\uC744 \uD5C8\uC6A9\uD558\uC138\uC694."});function Na(l,r,b){let g=b instanceof Error?b.message:String(b);if(Bo[g])return Bo[g];if(/^Invalid JSON|string.*JSON|^First JSON:|^Second JSON:/.test(g)||b instanceof SyntaxError&&/json|csv|table/.test(l)){let d=g;if(g==="Invalid JSON string")try{JSON.parse(r)}catch(I){d=I.message}return`JSON\uC744 \uC77D\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. ${cs(d,r)}`}if(/Invalid regular expression|regular expression flags|regular expression/i.test(g))return`\uC815\uADDC\uC2DD\uC744 \uC77D\uC9C0 \uBABB\uD588\uC2B5\uB2C8